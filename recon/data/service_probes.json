[
  {
    "name": "HTTP",
    "protocol": "tcp",
    "ports": [80, 8080, 8000, 8008, 8888],
    "probe_bytes": "GET / HTTP/1.0\r\nHost: {target}\r\nUser-Agent: Mozilla/5.0\r\n\r\n",
    "match_regex": "Server: (?P<version>[^\\r\\n]+)",
    "service_name": "http"
  },
  {
    "name": "HTTPS",
    "protocol": "tcp",
    "ports": [443, 8443, 4443],
    "probe_bytes": "HEAD / HTTP/1.0\r\nHost: {target}\r\n\r\n",
    "match_regex": "Server: (?P<version>[^\\r\\n]+)",
    "service_name": "https"
  },
