    "probe_encoding": "text",
    "probe": "GET / HTTP/1.0\r\nHost: {target}\r\nUser-Agent: Mozilla/5.0\r\n\r\n",
    "match_regex": "Server: (?P<version>[^\\r\\n]+)",
    "service_name": "http"
  },
